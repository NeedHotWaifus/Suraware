// Check registry for VM artifacts
func checkVMRegistry() bool {
	vmKeys := []string{
		"HARDWARE\\DEVICEMAP\\Scsi\\Scsi Port 0\\Scsi Bus 0\\Target Id 0\\Logical Unit Id 0",
		"HARDWARE\\Description\\System",
		"SYSTEM\\CurrentControlSet\\Services\\Disk\\Enum",
	}

	vmIdentifiers := []string{
		"vmware", "virtualbox", "vbox", "qemu", "xen", "virtual", "vmbus", "vmmouse",
	}

	for _, keyPath := range vmKeys {
		if checkRegistryForVM(keyPath, vmIdentifiers) {
			return true
		}
	}

	return false
}

