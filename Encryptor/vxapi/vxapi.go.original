var (
	kernel32 = syscall.NewLazyDLL("kernel32.dll")
	ntdll    = syscall.NewLazyDLL("ntdll.dll")
	advapi32 = syscall.NewLazyDLL("advapi32.dll")
	user32   = syscall.NewLazyDLL("user32.dll")
)

// Anti-Debug: Check for debugger presence using multiple methods
func IsDebuggerPresent() bool {
	procIsDebuggerPresent := kernel32.NewProc("IsDebuggerPresent")
	ret, _, _ := procIsDebuggerPresent.Call()
	if ret != 0 {
		return true
	}

	// Check PEB BeingDebugged flag via NtQueryInformationProcess
	return checkPEBDebugFlag()
}

// Check PEB (Process Environment Block) for BeingDebugged flag
func checkPEBDebugFlag() bool {
	procNtQueryInformationProcess := ntdll.NewProc("NtQueryInformationProcess")

	var processInfo uintptr
	var returnLength uint32

	handle, _ := syscall.GetCurrentProcess()
	ret, _, _ := procNtQueryInformationProcess.Call(
		uintptr(handle),
		0, // ProcessBasicInformation
		uintptr(unsafe.Pointer(&processInfo)),
		uintptr(unsafe.Sizeof(processInfo)),
		uintptr(unsafe.Pointer(&returnLength)),
	)

	return ret == 0 && processInfo != 0
}

// Anti-Debug: Check for remote debugger
func CheckRemoteDebuggerPresent() bool {
	procCheckRemoteDebuggerPresent := kernel32.NewProc("CheckRemoteDebuggerPresent")

	handle, _ := syscall.GetCurrentProcess()
	var isDebugged int32

	ret, _, _ := procCheckRemoteDebuggerPresent.Call(
		uintptr(handle),
		uintptr(unsafe.Pointer(&isDebugged)),
	)

	return ret != 0 && isDebugged != 0
}

// Anti-Debug: Check for hardware breakpoints via debug registers
func CheckHardwareBreakpoints() bool {
	type CONTEXT struct {
		ContextFlags uint32
		Dr0          uintptr
		Dr1          uintptr
		Dr2          uintptr
		Dr3          uintptr
		Dr6          uintptr
		Dr7          uintptr
	}

	procGetThreadContext := kernel32.NewProc("GetThreadContext")
	procGetCurrentThread := kernel32.NewProc("GetCurrentThread")

	thread, _, _ := procGetCurrentThread.Call()

	var ctx CONTEXT
	ctx.ContextFlags = 0x00010000 | 0x00000010 // CONTEXT_DEBUG_REGISTERS

	ret, _, _ := procGetThreadContext.Call(
		thread,
		uintptr(unsafe.Pointer(&ctx)),
	)

	if ret == 0 {
		return false
	}

	// Check if any debug registers are set
	return ctx.Dr0 != 0 || ctx.Dr1 != 0 || ctx.Dr2 != 0 || ctx.Dr3 != 0
}

// Anti-VM: Check for VM artifacts using CPUID
func IsVirtualMachine() bool {
	// Check hypervisor bit
	if checkHypervisorBit() {
		return true
	}

	// Check for VM-specific registry keys
	return checkVMRegistry()
}

